<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
  <Grid.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="Background" Value="{DynamicResource surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontWeight" Value="Medium"/><Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="body" Property="Opacity" Value="0.84"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="body" Property="Opacity" Value="0.66"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="body" Property="Opacity" Value="0.45"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="body" Property="BorderBrush" Value="{DynamicResource primary}"/><Setter TargetName="body" Property="BorderThickness" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="primaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource primary}"/><Setter Property="Foreground" Value="{DynamicResource on_primary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource primary}"/>
    </Style>
    <Style x:Key="modeSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="44"/><Setter Property="Height" Value="24"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="track" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource muted}" Background="{DynamicResource border}">
          <Ellipse x:Name="thumb" Width="16" Height="16" Margin="3" HorizontalAlignment="Left" Fill="{DynamicResource text}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="{DynamicResource primary}"/><Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource primary}"/><Setter TargetName="thumb" Property="Fill" Value="{DynamicResource on_primary}"/><Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderThickness" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <Border x:Name="MaterialRoot" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource border}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
      <Grid x:Name="LightEffects" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
        <Border><Border.Background><RadialGradientBrush Center="0.1,0.05" GradientOrigin="0.1,0.05" RadiusX="0.95" RadiusY="0.95"><GradientStop Color="#2876C2FF" Offset="0"/><GradientStop Color="#0076C2FF" Offset="1"/></RadialGradientBrush></Border.Background></Border>
        <Border><Border.Background><RadialGradientBrush Center="0.95,0.8" GradientOrigin="0.95,0.8" RadiusX="0.7" RadiusY="0.9"><GradientStop Color="#1567C8C4" Offset="0"/><GradientStop Color="#0067C8C4" Offset="1"/></RadialGradientBrush></Border.Background></Border>
      </Grid>
      <Grid x:Name="TitleBar" Background="Transparent" Margin="24,8,14,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="离线 OCR" VerticalAlignment="Center" FontWeight="Medium" FontSize="14"/>
        <Button x:Name="SettingsButton" Grid.Column="1" Style="{StaticResource quiet}" Content="设置" FontSize="12" Padding="12,4" MinHeight="32" AutomationProperties.Name="安装器设置"/>
        <Button x:Name="MinButton" Grid.Column="2" Style="{StaticResource quiet}" FontFamily="Segoe MDL2 Assets" Content="&#xE921;" Width="36" Padding="0" MinHeight="32" AutomationProperties.Name="最小化"/>
        <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource quiet}" FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;" Width="36" Padding="0" MinHeight="32" AutomationProperties.Name="关闭安装器"/>
      </Grid>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="38,22,38,8" Focusable="False">
        <Grid x:Name="Page" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
          <StackPanel>
            <TextBlock x:Name="Eyebrow" Text="安装应用" Foreground="{DynamicResource primary}" FontSize="12" FontWeight="Medium" Margin="0,0,0,12"/>
            <TextBlock x:Name="Heading" Text="安装离线 OCR" FontSize="32" FontWeight="Medium" Margin="0,0,0,12"/>
            <TextBlock x:Name="Description" Text="本地识别、校对与导出。" Foreground="{DynamicResource secondary}" FontSize="14" Margin="0,0,0,22"/>
            <Border x:Name="InfoPanel" Background="{DynamicResource panel}" BorderBrush="{DynamicResource border}" BorderThickness="1" CornerRadius="10" Padding="20,16">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="离线 OCR" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionLabel" Grid.Column="1" FontSize="22" Foreground="{DynamicResource primary}" VerticalAlignment="Center"/>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource border}" Height="1" Margin="0,14,0,12"/>
                <StackPanel Grid.Row="2">
                  <TextBlock Text="安装位置" FontSize="11" Foreground="{DynamicResource muted}" Margin="0,0,0,5"/>
                  <TextBlock x:Name="LocationLabel" FontSize="12" Foreground="{DynamicResource secondary}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="BrowseButton" Grid.Row="2" Grid.Column="1" Content="更改" Style="{StaticResource quiet}" FontSize="12" Padding="10,4" MinHeight="32" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <Button x:Name="RollbackButton" Content="恢复更新前版本" Style="{StaticResource quiet}" FontSize="12" Padding="0,8" HorizontalAlignment="Left" Visibility="Collapsed"/>
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
              <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StageLabel" FontSize="14" FontWeight="Medium"/>
                <TextBlock x:Name="PercentLabel" Grid.Column="1" FontSize="12" Foreground="{DynamicResource muted}"/>
              </Grid>
              <ProgressBar x:Name="Progress" Height="4" Foreground="{DynamicResource primary}" Background="{DynamicResource border}" BorderThickness="0" Minimum="0" Maximum="100"/>
              <TextBlock x:Name="ProgressHint" Text="正在处理，请稍候。" FontSize="12" Foreground="{DynamicResource muted}" Margin="0,13,0,0"/>
            </StackPanel>
            <TextBlock x:Name="Notice" FontSize="12" Foreground="{DynamicResource muted}" Margin="0,16,0,0"/>
            <StackPanel x:Name="NotesPanel" Visibility="Collapsed" Margin="0,12,0,0"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource border}" Padding="30,20">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="DetailsButton" Content="本次更新" HorizontalAlignment="Left" Style="{StaticResource quiet}" Padding="8,8" FontSize="12"/>
          <Button x:Name="SecondaryButton" Grid.Column="1" Content="取消" Margin="8,0,10,0" MinWidth="90"/>
          <Button x:Name="PrimaryButton" Grid.Column="2" Content="开始安装" MinWidth="132" Style="{StaticResource primaryButton}" IsDefault="True"/>
        </Grid>
      </Border>
      <Grid x:Name="SettingsLayer" Grid.Row="1" Grid.RowSpan="2" Background="Transparent" Visibility="Collapsed">
        <Border x:Name="SettingsPanel" Background="{DynamicResource surface}" BorderBrush="{DynamicResource border}" BorderThickness="1" CornerRadius="10" Padding="20,16" Width="300" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,24,0">
          <StackPanel>
            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="设置" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/>
              <Button x:Name="SettingsCloseButton" Grid.Column="1" Style="{StaticResource quiet}" Content="关闭" FontSize="12" Padding="8,2" MinHeight="28" AutomationProperties.Name="关闭设置"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="低性能模式" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
              <ToggleButton x:Name="LowPerformanceToggle" Grid.Column="1" Style="{StaticResource modeSwitch}" AutomationProperties.Name="低性能模式"/>
            </Grid>
            <TextBlock Text="浅色界面，关闭光效、磨砂和动画。" FontSize="12" Foreground="{DynamicResource secondary}" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Grid>
